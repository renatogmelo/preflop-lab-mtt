{
  "name": "preflop-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "solver": "node --import tsx solver/cli/index.ts",
    "solver:kuhn": "node --import tsx solver/cli/index.ts solve solver/configs/kuhn-dcfr.json",
    "solver:holdem": "node --import tsx solver/cli/index.ts solve solver/configs/holdem-poc.json",
    "solver:benchmark": "node --import tsx solver/cli/index.ts benchmark",
    "solver:phase4": "node --import tsx solver/benchmarks/phase4.ts",
    "solver:phase5": "node --import tsx solver/benchmarks/phase5.ts",
    "solver:phase6": "node --import tsx solver/benchmarks/phase6.ts",
    "solver:phase6-5": "node --import tsx solver/benchmarks/phase6-5.ts",
    "solver:phase6-6": "node --import tsx solver/benchmarks/phase6-6.mjs",
    "solver:phase6-6-finalize": "node --import tsx solver/benchmarks/phase6-6-finalize.mjs",
    "solver:phase6-6-docs": "node solver/benchmarks/render-phase6-6-docs.mjs",
    "solver:phase6-7": "node --import tsx solver/benchmarks/phase6-7.ts",
    "solver:phase6-8": "node --import tsx solver/benchmarks/phase6-8.ts",
    "solver:phase6-9": "node --import tsx solver/benchmarks/phase6-9.ts",
    "solver:phase6-10": "node --import tsx solver/benchmarks/phase6-10.ts",
    "solver:phase6-11": "node --import tsx solver/benchmarks/phase6-11.ts",
    "solver:phase6-12": "node --import tsx solver/benchmarks/phase6-12.ts",
    "solver:phase6-12-finalize": "node --import tsx solver/benchmarks/phase6-12-finalize.ts",
    "solver:phase6-13": "node --import tsx solver/benchmarks/phase6-13.ts",
    "solver:phase6-13-finalize": "node --import tsx solver/benchmarks/phase6-13-finalize.ts",
    "solver:phase6-14": "node --import tsx solver/benchmarks/phase6-14.ts",
    "solver:phase6-14-finalize": "node --import tsx solver/benchmarks/phase6-14-finalize.ts",
    "solver:phase6-15": "node --import tsx solver/benchmarks/phase6-15.ts",
    "solver:phase6-15-finalize": "node --import tsx solver/benchmarks/phase6-15-finalize.ts",
    "research": "node --import tsx solver/research/cli.ts",
    "research:console-api": "node --import tsx solver/research/console/server.ts",
    "research:console": "node --import tsx solver/research/console/dev.ts",
    "research:console-release": "node --import tsx solver/research/console/release.ts",
    "research:release": "node --import tsx solver/research/release.ts",
    "test:research": "node --import tsx --test tests/solver-phase7-0.test.mjs",
    "test:research-console": "node --import tsx --test tests/solver-phase7-1.test.mjs",
    "test:release": "node --import tsx --test tests/solver-phase6-13.test.mjs tests/solver-phase6-14.test.mjs tests/solver-phase6-15.test.mjs tests/solver-phase7-0.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "bin": {
    "preflop-research": "./solver/research/cli.ts"
  },
  "exports": {
    ".": "./solver/research/public/index.ts",
    "./research": "./solver/research/public/index.ts"
  }
}
